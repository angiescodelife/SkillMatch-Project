# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite (default) or postgresql.
# A DATABASE_URL (as Render provides) overrides the settings below.
# DATABASE_URL=postgresql://user:password@host:5432/skillmatch
DATABASE_ENGINE=sqlite
POSTGRES_DB=skillmatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google sign-in (leave blank to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional semantic matching (requires requirements-ai.txt)
SKILLMATCH_USE_SENTENCE_TRANSFORMERS=False
SKILLMATCH_SENTENCE_MODEL=all-MiniLM-L6-v2
